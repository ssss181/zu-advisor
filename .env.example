# Copy this file to ".env" (in this same folder) and paste ONE key after the = sign.
# The .env file is never sent to the browser.

# Option 1 — Google Gemini (FREE tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option 2 — Anthropic Claude (paid). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: change the model
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-opus-5-5
